# Copy this file to .env.local and fill in the new website's details.
# Full address of the live site, without a trailing slash (used for canonical
# URLs, Open Graph, sitemap.xml and robots.txt).
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com
# Name shown in page titles ("Page title | Site name") and the logo alt text.
NEXT_PUBLIC_SITE_NAME=Publish Your Books Today
# Contact email shown in the header, footer and contact page.
NEXT_PUBLIC_CONTACT_EMAIL=info@your-domain.com
